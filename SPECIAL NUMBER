import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int original = n;
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;
            int fact = 1;

            for (int i = 1; i <= digit; i++) {
                fact = fact * i;
            }

            sum += fact;
            n = n / 10;
        }

        if (original == sum) {
            System.out.println("It is special number");
        } else {
            System.out.println("It is not a special number");
        }
    }
}
