import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] price = new int[n];

        for (int i = 0; i < n; i++) {
            price[i] = sc.nextInt();
        }

        int minprice = price[0];
        int maxprofit = 0;

        for (int i = 1; i < n; i++) {
            int profit = price[i] - minprice;

            if (price[i] < minprice) {
                minprice = price[i];
            }

            if (maxprofit < profit) {
                maxprofit = profit;
            }
        }

        System.out.println(maxprofit);
    }
}
